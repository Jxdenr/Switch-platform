# Copy to .env and change every value marked CHANGE.
SECRET_KEY=CHANGE-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=switch.example.com
CSRF_TRUSTED_ORIGINS=https://switch.example.com
TIME_ZONE=Europe/London
POSTGRES_PASSWORD=CHANGE-db-password
DATABASE_URL=postgres://switch:CHANGE-db-password@db:5432/switch
INGEST_TOKEN=CHANGE-random-token-shared-with-jasmin
JASMIN_JCLI_HOST=jasmin
JASMIN_JCLI_PORT=8990
JASMIN_JCLI_USER=jcliadmin
JASMIN_JCLI_PASSWORD=jclipwd
JASMIN_MO_CALLBACK_URL=http://web:8000/ingest/jasmin/

# Logins. Platform admins (manage.py createsuperuser) must use an authenticator app.
# Add owner here to require it for every portal owner too: REQUIRE_2FA_ROLES=owner
REQUIRE_2FA_ROLES=
SESSION_HOURS=12
# Behind Caddy (TLS proxy): 1. Set 0 only if the app faces the internet directly.
TRUST_PROXY=1
# Django's raw database admin at /admin/ (reaches every portal's data). Leave 0 in production.
DJANGO_ADMIN=0

# Statements / invoices. Each portal sets its own company and bank details on its Settings page;
# these are only used to fill in the first portal when existing data is moved into it.
COMPANY_NAME=Your Company Ltd
COMPANY_DETAILS=1 Example Street, London\nCompany no. 00000000 · VAT GB000000000\nBank: Example Bank · Sort code 00-00-00 · Account 00000000
STATEMENT_SEND_DAY=1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=billing@yourcompany.com

# Built-in SMPP server
SMPP_SERVER_PORT=2775
